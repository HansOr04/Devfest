# Copy to .env and edit before `docker compose up -d`

# Domain served by Caddy (HTTPS is automatic). Use :80 to serve plain HTTP on any host.
DOMAIN=muro.tudevfest.com

# Postgres
POSTGRES_USER=devfest
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=devfest

# Panel /admin. Long and random.
ADMIN_TOKEN=change-me-too

# How often the wall snapshot is rebuilt and pushed to screens (ms)
SNAPSHOT_INTERVAL_MS=2000

# Interruptor del service worker. Déjalo vacío para producción normal.
# Ponlo en 1 y reconstruye para desactivarlo y limpiarlo de los teléfonos.
VITE_DISABLE_SW=
